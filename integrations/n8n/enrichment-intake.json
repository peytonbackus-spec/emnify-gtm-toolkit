{
  "name": "emnify enrichment intake (dry-run by default)",
  "nodes": [
    {
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "enrichment-intake",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "Check contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const p = $json.body || $json;\nconst errors = [];\nif (!/^[a-z0-9.-]+\\.[a-z]{2,}$/.test(p.domain || '')) errors.push('domain');\nif (!p.approved_by) errors.push('approved_by');\nif (!p.provenance) errors.push('provenance');\nreturn [{ json: { ...p, errors, valid: errors.length === 0 } }];"
      }
    },
    {
      "id": "n3",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "Dry run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $env.DRY_RUN !== 'false' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n5",
      "name": "Upsert Salesforce (live path)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -200
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SFDC_INSTANCE_URL }}/services/data/v60.0/sobjects/Account/Website_Domain__c/{{ $json.domain }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.fields) }}",
        "options": {
          "retry": {
            "maxTries": 3
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      }
    },
    {
      "id": "n6",
      "name": "Respond: planned",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'dry_run', domain: $json.domain } }}"
      }
    },
    {
      "id": "n7",
      "name": "Respond: rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'rejected', errors: $json.errors } }}",
        "options": {
          "responseCode": 422
        }
      }
    },
    {
      "id": "n8",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -220
      ],
      "parameters": {
        "content": "Hypothesis: validate. Field names, credential type and API version are placeholders. Live path stays unreachable while DRY_RUN is not 'false'. Import only after the Salesforce integration user and approval step exist."
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Check contract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check contract": {
      "main": [
        [
          {
            "node": "Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid?": {
      "main": [
        [
          {
            "node": "Dry run?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond: rejected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dry run?": {
      "main": [
        [
          {
            "node": "Respond: planned",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Upsert Salesforce (live path)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "emnify-error-handler"
  },
  "active": false,
  "pinData": {},
  "tags": []
}