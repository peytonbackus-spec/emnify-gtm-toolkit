# LLM settings (live mode only; the toolkit runs offline in mock mode by default)
GTM_LLM_MODE=mock
# Model used by shared_core/ai_governance/llm_client.py and scripts/gtm_reporting_agent.py
GTM_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# emnify integrations (names only; leave blank here, set real values in your shell or secret store)
SFDC_INSTANCE_URL=
SFDC_ACCESS_TOKEN=
ZOOMINFO_USERNAME=
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY=
AMPLEMARKET_API_KEY=
ATTENTION_API_KEY=
WEFLOW_API_KEY=
CLAY_API_KEY=
# n8n runtime (workflows stay in dry-run unless DRY_RUN=false)
DRY_RUN=true
ALERT_WEBHOOK_URL=
