{
  "mcpServers": {
    "speed-to-lead": {
      "command": "${HOME}/code/gtm-revops-toolkit/mcp/speed_to_lead/.venv/bin/python",
      "args": ["${HOME}/code/gtm-revops-toolkit/mcp/speed_to_lead/server.py"],
      "env": { "SPEED_TO_LEAD_ADAPTERS": "crm=json,calendar=json" }
    },
    "gtm-toolkit": {
      "command": "${HOME}/code/gtm-revops-toolkit/mcp/gtm_toolkit/.venv/bin/python",
      "args": ["${HOME}/code/gtm-revops-toolkit/mcp/gtm_toolkit/server.py"],
      "env": {
        "PYTHONPATH": "${HOME}/code/gtm-revops-toolkit",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY:-}"
      }
    }
  }
}
